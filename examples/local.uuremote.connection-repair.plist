<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.uuremote.connection-repair</string>
    <key>ProgramArguments</key>
    <array>
        <string>/absolute/path/to/python3</string>
        <string>/absolute/path/to/uu_connection_proxy.py</string>
        <string>--port</string>
        <string>17891</string>
        <string>--log</string>
        <string>/absolute/path/to/existing-directory/connection.log</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
